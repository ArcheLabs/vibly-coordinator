{
  "name": "vibly-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@concord/adapter-evm-indexer": "workspace:*",
    "@concord/adapter-substrate-indexer": "workspace:*",
    "@concord/adapters": "workspace:*",
    "@concord/core": "workspace:*",
    "@concord/foundation": "workspace:*",
    "@concord/governance": "workspace:*",
    "@concord/invariants": "workspace:*",
    "@concord/project": "workspace:*",
    "@concord/sdk": "workspace:*",
    "@concord/trace": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.3",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
