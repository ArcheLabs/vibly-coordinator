{
  "name": "vibly-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm verify:openapi && pnpm verify:contract-types && pnpm check:response-schemas && tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset.ts",
    "dump:openapi": "tsx --env-file-if-exists=.env scripts/dump-openapi.ts",
    "verify:openapi": "tsx --env-file-if-exists=.env scripts/verify-openapi.ts",
    "verify:contract-types": "node ../vibly-coordinator-http-contract/scripts/verify-types.mjs",
    "check:response-schemas": "tsx scripts/check-response-schemas.ts"
  },
  "dependencies": {
    "@concord/adapter-evm-indexer": "workspace:*",
    "@concord/adapter-substrate-actions": "workspace:*",
    "@concord/adapter-substrate-indexer": "workspace:*",
    "@concord/adapters": "workspace:*",
    "@concord/core": "workspace:*",
    "@concord/foundation": "workspace:*",
    "@concord/governance": "workspace:*",
    "@concord/invariants": "workspace:*",
    "@concord/project": "workspace:*",
    "@concord/sdk": "workspace:*",
    "@concord/trace": "workspace:*",
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/auto-instrumentations-node": "^0.74.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/sdk-node": "^0.216.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.2.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
