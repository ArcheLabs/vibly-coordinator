NODE_ENV=development
HOST=0.0.0.0
PORT=8787

LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=

DATABASE_URL=file:./data/vibly-coordinator.sqlite
STORAGE_MODE=sqlite

COORDINATOR_ID=local-coordinator

API_AUTH_MODE=static-token
API_TOKENS=dev-token

SSE_HEARTBEAT_MS=15000

TRACE_OUTPUT_DIR=./data/traces

ENABLE_SWAGGER=true
ENABLE_DEV_ROUTES=true

SUBSTRATE_CHAIN_ID=substrate:vibly-solo
SUBSTRATE_RPC_URL=ws://127.0.0.1:9944
SUBSTRATE_INDEXER_URL=

# ── Guardian authority for privileged organization administration ──────────
# Production must use CHAIN_AUTHORITY_MODE=rpc and ORG_ADMIN_AUTHORITY_SOURCE=guardian.
# Development may keep local mode for demos.
CHAIN_AUTHORITY_MODE=disabled
CHAIN_AUTHORITY_RPC_URL=
CHAIN_AUTHORITY_CHAIN_ID=substrate:vibly-solo
CHAIN_AUTHORITY_CACHE_TTL_MS=60000
CHAIN_AUTHORITY_MAX_STALENESS_BLOCKS=50
ORG_ADMIN_AUTHORITY_SOURCE=local

# ── Get VIB purchase path ──────────────────────────────────────────────────
# Set the on-screen / order deposit address used by Get VIB.
# If this is blank, `/get-vib/config` returns `purchaseEnabled=false`
# and the Console shows "Purchasing is not enabled...".
# Local demo example:
# VIBLY_DOT_RECEIVING_ADDRESS=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY
VIBLY_DOT_RECEIVING_ADDRESS=

# Optional: force-disable buying even when a deposit address exists.
# `false` = curve quoting + order creation allowed
# `true`  = `/get-vib/config` reports `paused=true` and buy quote endpoints reject
GET_VIB_CURVE_PAUSED=false

# Optional: relay token label shown in the Get VIB UI.
# Use `DOT` for Polkadot, `PLA` for Paseo / local test labels, etc.
GET_VIB_RELAY_TOKEN_SYMBOL=DOT

# Optional: relay token decimals used when parsing watched relay deposits.
# Polkadot DOT is 10 decimals.
GET_VIB_RELAY_TOKEN_DECIMALS=10

# ── Get VIB relay deposit watcher ──────────────────────────────────────────
# Configure these only when the coordinator should watch finalized relay-chain
# deposits and auto-create Get VIB allocations from them.
# For quote-only / manual finalize flows, they may stay blank / zero.
#
# Relay-chain RPC watched by the deposit watcher.
# Example:
# GET_VIB_RELAY_RPC_URL=wss://rpc.polkadot.io
GET_VIB_RELAY_RPC_URL=

# Logical relay-chain id written into observed deposit source ids.
# Keep this stable for a given watched network.
GET_VIB_RELAY_CHAIN_ID=polkadot-dev

# Watch loop interval in milliseconds.
# `0` disables background scanning entirely.
GET_VIB_DEPOSIT_SCAN_INTERVAL_MS=0

# First relay-chain block the watcher should begin scanning from.
# Useful for local resets or starting from a known deployment block.
GET_VIB_DEPOSIT_START_BLOCK=0

# Extra finalized blocks to wait before treating a relay deposit as confirmed.
# `0` is acceptable for local dev; use a positive value on shared testnets.
GET_VIB_DEPOSIT_FINALITY_BLOCKS=0

# ── Get VIB claim root uploader ────────────────────────────────────────────
# Keep claims disabled until the Vibly Chain is officially online and the first
# claim root is uploaded. Users may still buy via Polkadot mainnet while this is false.
GET_VIB_CLAIM_ENABLED=false

# Builds cumulative claim manifests and uploads vibClaim.setClaimRoot on a fixed cadence.
# `0` disables automatic root uploads.
GET_VIB_ROOT_UPLOAD_INTERVAL_MS=120000

# prepare-only: create local receipts only; fixture: fake tx hash; unsafe-papi: submit vibClaim.setClaimRoot directly.
# unsafe-papi must use a least-privilege on-chain Get VIB root publisher hot key, not sudo/root.
GET_VIB_ROOT_UPLOAD_MODE=prepare-only
GET_VIB_ROOT_PUBLISHER_URI=

# ── Agent rewards / incentivized testnet settlement ────────────────────────
# V1 rewards are protocol-only: self-stake base yield, observer/reviewer
# performance yield, and capped task rewards paid only to executors.
# `false` disables reward indexer sync and settlement background loops.
AGENT_REWARD_ENABLED=false

# Sync reward ledgers/day state/settlements from the SubQuery indexer.
# `0` disables the sync loop even if rewards are enabled.
AGENT_REWARD_SYNC_INTERVAL_MS=60000

# Submit missing base staking days and event-triggered observer/reviewer/task
# settlements. `0` disables periodic base catch-up; event-triggered settlement
# still requires AGENT_REWARD_ENABLED=true.
AGENT_REWARD_SETTLEMENT_INTERVAL_MS=60000

# prepare-only: local receipt only; fixture: fake tx hash; unsafe-papi: submit
# agentIncentives settlement extrinsics directly.
AGENT_REWARD_TX_MODE=prepare-only

# Required for AGENT_REWARD_TX_MODE=unsafe-papi. Use a dedicated hot key
# authorized only via agentIncentives.setRewardSettlementPublisher.
AGENT_REWARD_PUBLISHER_URI=

# ISO timestamp used by Coordinator to convert wall-clock time into reward day
# offsets. Day 0 is [AGENT_REWARD_EMISSION_START_AT, +24h).
AGENT_REWARD_EMISSION_START_AT=

# Maximum reward days the base staking catch-up loop submits per tick.
AGENT_REWARD_MAX_CATCHUP_DAYS=7

# hidden: keep legacy /rewards compatibility but don't show it in production UI.
# disabled: reject legacy mock write routes with 410. enabled: fully available.
LEGACY_REWARD_INTENT_MODE=hidden

# Public network manifest for GET /networks.
# `pnpm build` writes dist/network-manifest.json from network-manifest.production.json
# when present, otherwise from templates/network-manifest.production.json.example.
NETWORK_MANIFEST_FILE=

# Backward-compatible inline override for local tests only. Production should use NETWORK_MANIFEST_FILE.
NETWORK_MANIFEST_JSON=
