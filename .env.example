NODE_ENV=development
HOST=0.0.0.0
PORT=8787

LOG_LEVEL=info

DATABASE_URL=file:./data/vibly-coordinator.sqlite
STORAGE_MODE=sqlite

COORDINATOR_ID=local-coordinator

API_AUTH_MODE=static-token
API_TOKENS=dev-token

SSE_HEARTBEAT_MS=15000

TRACE_OUTPUT_DIR=./data/traces

ENABLE_SWAGGER=true
ENABLE_DEV_ROUTES=true

SUBSTRATE_CHAIN_ID=substrate:vibly-solo
SUBSTRATE_RPC_URL=ws://127.0.0.1:9944

# ── Get VIB purchase path ──────────────────────────────────────────────────
# Set the on-screen / order deposit address used by Get VIB.
# If this is blank, `/get-vib/config` returns `purchaseEnabled=false`
# and the Console shows "Purchasing is not enabled...".
# Local demo example:
# VIBLY_DOT_RECEIVING_ADDRESS=5GrwvaEF5zXb26Fz9rcQpDWS57CtERHpNehXCPcNoHGKutQY
VIBLY_DOT_RECEIVING_ADDRESS=

# Optional: force-disable buying even when a deposit address exists.
# `false` = curve quoting + order creation allowed
# `true`  = `/get-vib/config` reports `paused=true` and buy quote endpoints reject
GET_VIB_CURVE_PAUSED=false

# Optional: DOT/USD reference price used by the coordinator when converting
# a DOT payment budget into a USD-denominated launch-curve quote.
# This is an off-chain price snapshot for MVP, not an on-chain oracle.
GET_VIB_DOT_USD_PRICE=10.98

# Optional: orders at or above this USD amount are marked as requiring admin review.
GET_VIB_ADMIN_REVIEW_USD=10000

# Optional: relay token label shown in the Get VIB UI.
# Use `DOT` for Polkadot, `PLA` for Paseo / local test labels, etc.
GET_VIB_RELAY_TOKEN_SYMBOL=DOT

# Optional: relay token decimals used when parsing watched relay deposits.
# Polkadot DOT is 10 decimals.
GET_VIB_RELAY_TOKEN_DECIMALS=10

# ── Get VIB relay deposit watcher ──────────────────────────────────────────
# Configure these only when the coordinator should watch finalized relay-chain
# deposits and auto-create Get VIB allocations from them.
# For quote-only / manual finalize flows, they may stay blank / zero.
#
# Relay-chain RPC watched by the deposit watcher.
# Example:
# GET_VIB_RELAY_RPC_URL=wss://rpc.polkadot.io
GET_VIB_RELAY_RPC_URL=

# Logical relay-chain id written into observed deposit source ids.
# Keep this stable for a given watched network.
GET_VIB_RELAY_CHAIN_ID=polkadot-dev

# Watch loop interval in milliseconds.
# `0` disables background scanning entirely.
GET_VIB_DEPOSIT_SCAN_INTERVAL_MS=0

# First relay-chain block the watcher should begin scanning from.
# Useful for local resets or starting from a known deployment block.
GET_VIB_DEPOSIT_START_BLOCK=0

# Extra finalized blocks to wait before treating a relay deposit as confirmed.
# `0` is acceptable for local dev; use a positive value on shared testnets.
GET_VIB_DEPOSIT_FINALITY_BLOCKS=0

# ── Get VIB claim root uploader ────────────────────────────────────────────
# Builds cumulative claim manifests and uploads vibClaim.setClaimRoot on a fixed cadence.
# `0` disables automatic root uploads.
GET_VIB_ROOT_UPLOAD_INTERVAL_MS=600000

# prepare-only: create local receipts only; fixture: fake tx hash; unsafe-papi: submit vibClaim.setClaimRoot directly.
# unsafe-papi must use a least-privilege on-chain Get VIB root publisher hot key, not sudo/root.
GET_VIB_ROOT_UPLOAD_MODE=prepare-only
GET_VIB_ROOT_PUBLISHER_URI=
