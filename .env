NODE_ENV=development
HOST=0.0.0.0
PORT=8787

LOG_LEVEL=info

DATABASE_URL=file:./data/vibly-coordinator.sqlite
STORAGE_MODE=sqlite

COORDINATOR_ID=local-coordinator

API_AUTH_MODE=static-token
API_TOKENS=dev-token

SSE_HEARTBEAT_MS=15000

TRACE_OUTPUT_DIR=./data/traces

ENABLE_SWAGGER=true
ENABLE_DEV_ROUTES=true

VIBLY_DOT_RECEIVING_ADDRESS=13HBCidDHXxqpt5W6X4TgYYFSDmpSrhyr1J7ENedkMELAih2

# Relay deposit watcher (scans relay chain for DOT → receiving address)
GET_VIB_RELAY_RPC_URL=ws://127.0.0.1:9945
GET_VIB_RELAY_CHAIN_ID=polkadot-dev
GET_VIB_DEPOSIT_SCAN_INTERVAL_MS=10000
GET_VIB_DEPOSIT_START_BLOCK=0
GET_VIB_DEPOSIT_FINALITY_BLOCKS=0
