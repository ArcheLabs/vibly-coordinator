# Example Cloud Run env file:
#   gcloud run deploy vibly-coordinator \
#     --source . \
#     --region asia-east1 \
#     --project your-gcp-project \
#     --allow-unauthenticated \
#     --add-cloudsql-instances your-gcp-project:asia-east1:vibly-coordinator-pg \
#     --env-vars-file templates/cloud-run.env.yaml.example
#
# Replace placeholder values before use. This template targets the production
# safety checks in src/config/env.ts and assumes Cloud SQL-backed Postgres.

NODE_ENV: production
HOST: 0.0.0.0
PORT: "8080"
LOG_LEVEL: info
COORDINATOR_ID: coordinator-monolith

STORAGE_MODE: postgres
DATABASE_URL: postgresql://app_user:app_password@/vibly_coordinator?host=/cloudsql/your-gcp-project:asia-east1:vibly-coordinator-pg

API_AUTH_MODE: static-token
API_TOKENS: replace-this-with-a-long-random-service-token

CORS_ALLOWED_ORIGINS: https://console.example.com
CLIENT_VERSION_ENFORCEMENT: "true"
MINIMUM_CLIENT_VERSION: 0.1.0
RECOMMENDED_CLIENT_VERSION: 0.1.0
MINIMUM_CONTRACT_VERSION: 0.1.0
UPGRADE_INSTRUCTIONS_URL: https://docs.example.com/vibly/upgrade
PROTOCOL_VERSION: v1
ENABLE_SWAGGER: "false"
ENABLE_DEV_ROUTES: "false"

SUBSTRATE_CHAIN_ID: substrate:vibly-testnet
SUBSTRATE_RPC_URL: wss://rpc.lumen.example.com
SUBSTRATE_INDEXER_URL: https://indexer.example.com/graphql
SUBSTRATE_STAKE_TX_MODE: prepare-only
SUBSTRATE_GOVERNANCE_TX_MODE: prepare-only
SUBSTRATE_COORDINATOR_AUTHORITY_URI: //unused-in-prepare-only

CHAIN_AUTHORITY_MODE: rpc
CHAIN_AUTHORITY_RPC_URL: wss://rpc.lumen.example.com
CHAIN_AUTHORITY_CHAIN_ID: substrate:vibly-testnet
ORG_ADMIN_AUTHORITY_SOURCE: guardian

GOVERNANCE_BACKENDS: substrate-opengov
AGENT_STAKE_SYNC_INTERVAL_MS: "15000"
AGENT_STAKE_FRESHNESS_MS: "60000"

AGENT_REWARD_ENABLED: "true"
AGENT_REWARD_SYNC_INTERVAL_MS: "15000"
AGENT_REWARD_SETTLEMENT_INTERVAL_MS: "30000"
AGENT_REWARD_TX_MODE: unsafe-papi
AGENT_REWARD_PUBLISHER_URI: <reward-publisher-uri>
AGENT_REWARD_EMISSION_START_AT: 2026-06-01T00:00:00.000Z
AGENT_REWARD_MAX_CATCHUP_DAYS: "7"
LEGACY_REWARD_INTENT_MODE: hidden

GET_VIB_CLAIM_ENABLED: "false"
GET_VIB_ROOT_UPLOAD_INTERVAL_MS: "120000"
GET_VIB_ROOT_UPLOAD_MODE: prepare-only
GET_VIB_ROOT_PUBLISHER_URI: <claim-root-publisher-uri-if-enabled>

VIBLY_DOT_RECEIVING_ADDRESS: 1ReplaceThisWithYourPolkadotReceivingAddress
VIBLY_AIRDROP_DOMAIN: claims.vibly.network
VIBLY_CONVERSION_TOTAL_CAP: "30000000"
VIBLY_CONVERSION_INITIAL_RATE: "1100"
VIBLY_CONVERSION_SLOPE: "0"
VIBLY_CONVERSION_MIN_DOT: "0.1"
GET_VIB_RELAY_RPC_URL: https://rpc.ibp.network/polkadot
GET_VIB_RELAY_CHAIN_ID: polkadot
GET_VIB_RELAY_TOKEN_SYMBOL: DOT
GET_VIB_RELAY_TOKEN_DECIMALS: "10"
GET_VIB_DEPOSIT_SCAN_INTERVAL_MS: "15000"
GET_VIB_DEPOSIT_START_BLOCK: "0"
GET_VIB_DEPOSIT_FINALITY_BLOCKS: "6"
GET_VIB_CURVE_PAUSED: "false"

# `pnpm build` writes this file from `network-manifest.production.json`
# when present, otherwise from `templates/network-manifest.production.json.example`.
# Keep public coordinator/RPC URLs in that JSON file; do not inline it here.
NETWORK_MANIFEST_FILE: dist/network-manifest.json
